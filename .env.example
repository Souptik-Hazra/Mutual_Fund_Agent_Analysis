APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://mfa:mfa_dev_password@localhost:5432/mutual_fund_agent

LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=mutual-fund-agent-analysis

# Optional semantic document retrieval. Without Qdrant, the API uses PostgreSQL lexical retrieval.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=mutual_fund_research
DOCUMENT_EMBEDDING_MODEL=gemini-embedding-001

# Social connectors are opt-in and require platform approval/API credentials.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=MutualFundResearch/1.0
X_BEARER_TOKEN=
